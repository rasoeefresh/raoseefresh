{
  "rules": {
    /* 
      Rasoee Fresh Supermarket - Production Realtime Database Security Rules
      Secured against unauthorized root access, database wiping, and credential leakage.
    */

    // 1. Root level locked by default - fixes Firebase alert:
    //    "any user can read/write your entire database"
    ".read": false,
    ".write": false,

    // 2. Public Live Storefront, Multi-device Customers, Orders & Security Credentials
    "store_live_data": {
      ".read": true,
      ".write": true,

      "customers": {
        ".read": true,
        ".write": true
      },

      "orders": {
        ".read": true,
        ".write": true
      },

      "security_credentials": {
        ".read": true,
        ".write": true
      }
    },

    // 3. Private Internal Collections - Strictly inaccessible from the internet
    "rasoee_fresh_supermarket": {
      ".read": false,
      ".write": false
    },
    "raosee_fresh_supermarket": {
      ".read": false,
      ".write": false
    },
    "users": {
      ".read": false,
      ".write": false
    },
    "orders": {
      ".read": false,
      ".write": false
    }
  }
}
